# Required WhatsApp credentials
SESSION_ID=
OWNER_NUMBER=254700000000
OWNER_NAME=Silva
BOT_NAME=Silva MD

# Bot behavior
PREFIX=.
MODE=public
THEME=silva
AUTO_STATUS_SEEN=true
AUTO_STATUS_REACT=true
AUTO_TYPING=true
READ_MESSAGE=false

# Optional Agent v2 provider
# Use an OpenAI-compatible provider endpoint.
AGENT_API_KEY=
AGENT_API_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o-mini
AGENT_MAX_STEPS=5

# Optional encrypted Postgres storage
# Put the real Neon URLs in your host secrets, never in Git.
DATABASE_URL=
DATABASE_URL_POOLED=
# Optional Base64 form for private secret stores. Base64 is not encryption.
DATABASE_URL_B64=
DATABASE_URL_POOLED_B64=
# Use a long random secret. If omitted, the bot derives a key from SESSION_ID.
DB_ENCRYPTION_KEY=
DEVELOPER_NUMBERS=254700143167,254755257907,254743706010
