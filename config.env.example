# Required WhatsApp credentials
SESSION_ID=
OWNER_NUMBER=254700000000
OWNER_NAME=Silva
BOT_NAME=Silva MD

# Bot behavior
PREFIX=.
MODE=public
THEME=silva
AUTO_STATUS_SEEN=true
AUTO_STATUS_REACT=true
AUTO_TYPING=true
READ_MESSAGE=false

# Optional Agent v2 provider
# Use an OpenAI-compatible provider endpoint.
AGENT_API_KEY=
AGENT_API_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o-mini
AGENT_MAX_STEPS=5

# Optional encrypted Postgres storage. Put the real Neon URL in your host
# secret panel, never in Git. The supplied pooled Neon URL can be used here.
DATABASE_URL=
